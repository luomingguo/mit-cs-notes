---
import '@/styles/global.css';
import { AskNotes } from '@/components/AskNotes';
import { CommandPalette } from '@/components/CommandPalette';
import { siteBase, withBasePath } from '@/lib/notes';

interface Props {
  title: string;
  description: string;
  language?: 'zh' | 'en';
}

const { title, description, language = 'zh' } = Astro.props;
const homeHref = withBasePath('/');
const zhHref = withBasePath('/zh/');
const enHref = withBasePath('/en/');
const searchIndexUrl = withBasePath('/search-index.json');
const ragEnabled = siteBase() === '/';
const siteOrigin = process.env.SITE_ORIGIN ?? 'https://notes.lobomiao.uk';
const ogImage = new URL(withBasePath('/og-card.png'), siteOrigin).href;
---
<!doctype html>
<html lang={language === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · MIT CS Notes`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <title>{title} · MIT CS Notes</title>
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('mit-notes-theme');
          var dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch (error) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#atlas-content">{language === 'zh' ? '跳到正文' : 'Skip to content'}</a>
    <header class="atlas-topbar">
      <a class="brand atlas-brand" href={homeHref}><span>cs<span class="brand-dot">.</span>kb</span><small>knowledge base</small></a>
      <button class="atlas-search search-open" type="button" aria-label={language === 'zh' ? '打开搜索' : 'Open search'}><span aria-hidden="true">⌕</span><span>{language === 'zh' ? '搜索领域、课程和讲义…' : 'Search domains, courses and notes…'}</span><kbd>⌘K</kbd></button>
      <nav class="atlas-links" aria-label={language === 'zh' ? '全站导航' : 'Site navigation'}>
        <a href={zhHref} aria-current={language === 'zh' ? 'page' : undefined}>中文</a>
        <a href={enHref} aria-current={language === 'en' ? 'page' : undefined}>EN</a>
        <button class="theme-toggle" type="button" aria-label={language === 'zh' ? '切换深浅色' : 'Toggle color theme'}>◐</button>
        <a href="https://github.com/luomingguo" rel="noreferrer">GitHub ↗</a>
      </nav>
    </header>
    <main id="atlas-content"><slot /></main>
    <CommandPalette client:idle indexUrl={searchIndexUrl} />
    {ragEnabled && <AskNotes client:idle />}
    <script is:inline>
      (function () {
        document.querySelectorAll('.search-open').forEach(function (button) {
          button.addEventListener('click', function () { window.dispatchEvent(new Event('open-note-search')); });
        });
        document.querySelectorAll('.theme-toggle').forEach(function (button) {
          button.addEventListener('click', function () {
            var dark = document.documentElement.classList.toggle('dark');
            try { localStorage.setItem('mit-notes-theme', dark ? 'dark' : 'light'); } catch (error) {}
          });
        });
      })();
    </script>
  </body>
</html>
