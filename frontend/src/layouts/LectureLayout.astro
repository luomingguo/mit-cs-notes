---
import '@/styles/global.css';
import { CommandPalette } from '@/components/CommandPalette';
import { AskNotes } from '@/components/AskNotes';
import { MobileNavSheet } from '@/components/MobileNavSheet';
import { RelationsSheet } from '@/components/RelationsSheet';
import { TocHighlighter } from '@/components/TocHighlighter';
import CourseNav from '@/components/CourseNav.astro';
import TocRail from '@/components/TocRail.astro';
import type { Backlink, NavDomain, NavLecture, SearchItem } from '@/lib/notes';
import { siteBase, withBasePath } from '@/lib/notes';
import { ExternalLink, MoonStar, Search } from 'lucide-react';

interface Heading { depth: number; slug: string; text: string }
interface Props {
  title: string;
  description: string;
  domains: NavDomain[];
  lectures: NavLecture[];
  searchIndex?: SearchItem[];
  searchIndexUrl?: string;
  headings: Heading[];
  courseName: string;
  courseId: string;
  courseHref: string;
  totalNotes: number;
  lecturePosition: number | null;
  lectureCount: number;
  tags: string[];
  backlinks: Backlink[];
}

const {
  title,
  description,
  domains,
  lectures,
  searchIndex = [],
  searchIndexUrl,
  headings,
  courseName,
  courseId,
  courseHref,
  totalNotes,
  lecturePosition,
  lectureCount,
  tags,
  backlinks,
} = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const homeHref = withBasePath('/');
const pathsHref = withBasePath('/zh/paths');
const ragEnabled = siteBase() === '/';
const siteOrigin = process.env.SITE_ORIGIN ?? 'https://notes.lobomiao.uk';
const ogImage = new URL(withBasePath('/og-card.png'), siteOrigin).href;
const badge = withBasePath('/brand/archipelago-badge-64.png');
const favicon = badge;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={favicon} type="image/png" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${title} · Archipelago`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <title>{title} · Archipelago</title>
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('archipelago-theme') || localStorage.getItem('mit-notes-theme');
          var dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch (error) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#lecture-content">跳到正文</a>

    <header class="mobile-header">
      <MobileNavSheet client:idle domains={domains} lectures={lectures} courseName={courseName} courseId={courseId} />
      <a href={homeHref} class="brand brand-mobile" aria-label="Archipelago 群岛首页"><img src={badge} width="32" height="32" alt="" /><span class="brand-copy"><strong>Archipelago</strong></span></a>
      <div class="mobile-actions">
        <button class="icon-button search-open" type="button" aria-label="打开搜索"><Search aria-hidden="true" /></button>
        <button class="icon-button theme-toggle" type="button" aria-label="切换深浅色"><MoonStar aria-hidden="true" /></button>
      </div>
    </header>

    <div class="site-shell">
      <aside class="left-sidebar">
        <div class="sidebar-head">
          <div class="brand-row">
            <a href={homeHref} class="brand" aria-label="Archipelago 群岛首页"><img src={badge} width="40" height="40" alt="" /><span class="brand-copy"><strong>Archipelago</strong><small>群岛 · 公开课笔记</small></span></a>
            <div class="sidebar-actions">
              <button class="icon-button theme-toggle" type="button" aria-label="切换深浅色"><MoonStar aria-hidden="true" /></button>
              <a class="icon-button" href="https://github.com/luomingguo" aria-label="GitHub" rel="noreferrer"><ExternalLink aria-hidden="true" /></a>
            </div>
          </div>
          <button class="search-trigger search-open" type="button">
            <Search aria-hidden="true" /><span>搜索笔记…</span><kbd>⌘K</kbd>
          </button>
        </div>
        <div class="sidebar-scroll">
          <CourseNav domains={domains} lectures={lectures} courseName={courseName} courseId={courseId} courseHref={courseHref} totalNotes={totalNotes} />
        </div>
        <div class="sidebar-foot"><a href={pathsHref}>学习路径 →</a><span>真实 Markdown</span></div>
      </aside>

      <main id="lecture-content" class="main-column">
        <div class="tablet-relations">
          <RelationsSheet client:idle headings={tocHeadings} lecturePosition={lecturePosition} lectureCount={lectureCount} tags={tags} backlinks={backlinks} />
        </div>
        <slot />
      </main>

      <aside class="right-sidebar">
        <TocRail headings={tocHeadings} lecturePosition={lecturePosition} lectureCount={lectureCount} tags={tags} backlinks={backlinks} />
      </aside>
    </div>

    <CommandPalette client:idle index={searchIndex} indexUrl={searchIndexUrl} />
    {ragEnabled && <AskNotes client:idle />}
    <TocHighlighter client:idle />
    <script is:inline>
      (function () {
        document.querySelectorAll('.search-open').forEach(function (button) {
          button.addEventListener('click', function () { window.dispatchEvent(new Event('open-note-search')); });
        });
        document.querySelectorAll('.theme-toggle').forEach(function (button) {
          button.addEventListener('click', function () {
            var dark = document.documentElement.classList.toggle('dark');
            try { localStorage.setItem('archipelago-theme', dark ? 'dark' : 'light'); } catch (error) {}
          });
        });
      })();
    </script>
  </body>
</html>
