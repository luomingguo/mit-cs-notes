---
import { getCollection, render } from 'astro:content';
import CourseView from '@/components/CourseView.astro';
import DomainView from '@/components/DomainView.astro';
import HomeView from '@/components/HomeView.astro';
import { LearningPath } from '@/components/LearningPath';
import LectureLayout from '@/layouts/LectureLayout.astro';
import { buildCatalog, courseForEntry, domainForEntry } from '@/lib/catalog';
import { sourceHeadings } from '@/lib/heading-ids';
import { loadLearningPaths } from '@/lib/learning-paths';
import {
  buildNavLectures,
  buildTaxonomy,
  complexityOf,
  courseEntriesOf,
  courseIdOf,
  courseOf,
  dataOf,
  domainLabelOf,
  findBacklinks,
  findPrevNext,
  idToHref,
  idToUrlPath,
  isCourseIndex,
  isDomainIndex,
  isRootIndex,
  lastUpdatedOf,
  lectureOf,
  plainExcerpt,
  rewriteRenderedInternalLinks,
  selectComplexNote,
  tagsOf,
  titleOf,
  withBasePath,
} from '@/lib/notes';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  const selected = selectComplexNote(notes);
  console.info(`[migration] ${notes.length} Markdown entries; QA sample ${selected.id}: ${JSON.stringify(complexityOf(selected))}`);

  return notes.flatMap((entry) => {
    const canonical = idToUrlPath(entry.id);
    const paths = [{ slug: canonical || 'index', alias: !canonical }];
    if (entry.id.endsWith('/index') && canonical) paths.push({ slug: `${canonical}/index`, alias: true });
    return paths.map(({ slug, alias }) => ({
      params: { slug },
      props: { entryId: entry.id, selectedId: selected.id, alias },
    }));
  });
}

const { entryId, selectedId, alias } = Astro.props as { entryId: string; selectedId: string; alias: boolean };
const allNotes = await getCollection('notes');
const catalog = buildCatalog(allNotes);
const entry = allNotes.find((note) => note.id === entryId);
if (!entry) throw new Error(`找不到内容：${entryId}`);

await render(entry);
const headings = sourceHeadings(entry.body ?? '');
const renderedHtml = (entry as typeof entry & { rendered?: { html?: string } }).rendered?.html ?? '';
const contentHtml = rewriteRenderedInternalLinks(renderedHtml, entry.id);
const domain = domainForEntry(catalog, entry);
const course = courseForEntry(catalog, entry);
const courseEntries = course?.entries ?? courseEntriesOf(allNotes, entry.id);
const contentEntries = courseEntries.filter((note) => !isCourseIndex(note));
const contentPosition = Math.max(0, contentEntries.findIndex((note) => note.id === entry.id)) + 1;
const { prev, next } = findPrevNext(entry, courseEntries);
const title = titleOf(entry);
const courseName = course?.title ?? courseOf(entry);
const courseId = course?.courseId ?? courseIdOf(entry);
const lecture = lectureOf(entry);
const summary = plainExcerpt(entry.body ?? '');
const navLectures = buildNavLectures(courseEntries, entry.id);
const tags = tagsOf(entry);
const backlinks = findBacklinks(entry, allNotes);
const lastUpdated = lastUpdatedOf(entry);
const kindLabels: Record<string, string> = { theory: '理论', system: '系统', source: '源码研读', design: '设计' };
const statusLabels: Record<string, string> = { complete: '完成', draft: '草稿', stub: '占位' };
const entryData = dataOf(entry);
const kind = kindLabels[String(entryData.kind ?? '')] ?? String(entryData.kind ?? '笔记');
const status = statusLabels[String(entryData.status ?? '')] ?? String(entryData.status ?? '状态未知');
const searchIndexUrl = withBasePath('/search-index.json');
const courseHref = course?.href ?? withBasePath('/zh/');
const isContentPage = !isRootIndex(entry) && !isDomainIndex(entry) && !isCourseIndex(entry);
const learningPathOpening = contentHtml.match(/<learningpath(?:\s[^>]*)?>/i);
const hasLearningPath = Boolean(learningPathOpening?.index !== undefined);
const learningPathSegments = hasLearningPath && learningPathOpening?.index !== undefined ? [
  contentHtml.slice(0, learningPathOpening.index),
  contentHtml.slice(learningPathOpening.index + learningPathOpening[0].length).replace(/<\/learningpath>\s*$/i, ''),
] : [contentHtml];
const sourceLearningPaths = hasLearningPath ? await loadLearningPaths() : null;
const learningPaths = sourceLearningPaths ? {
  ...sourceLearningPaths,
  paths: Object.fromEntries(Object.entries(sourceLearningPaths.paths).map(([slug, route]) => [slug, {
    ...route,
    steps: route.steps.map((step) => ({
      ...step,
      notes: step.notes.map((note) => ({ ...note, url: withBasePath(note.url) })),
    })),
  }])),
} : null;
---
{isRootIndex(entry) ? (
  <HomeView catalog={catalog} />
) : isDomainIndex(entry) && domain ? (
  <DomainView catalog={catalog} domain={domain} contentHtml={contentHtml} />
) : isCourseIndex(entry) && domain && course ? (
  <CourseView catalog={catalog} domain={domain} course={course} contentHtml={contentHtml} />
) : isContentPage ? (
  <LectureLayout
    title={title}
    description={summary}
    domains={buildTaxonomy(allNotes, entry.id)}
    lectures={navLectures}
    searchIndexUrl={searchIndexUrl}
    headings={headings}
    courseName={courseName}
    courseId={courseId}
    courseHref={courseHref}
    totalNotes={catalog.totalNotes}
    lecturePosition={contentPosition}
    lectureCount={contentEntries.length}
    tags={tags}
    backlinks={backlinks}
  >
    <article class="lecture-article" data-qa-sample={entry.id === selectedId ? 'selected' : undefined} data-alias={alias ? 'true' : undefined}>
      <header class="lecture-header">
        <nav class="breadcrumb" aria-label="面包屑">
          {domain ? <a href={domain.href}>{domain.label}</a> : <span>{domainLabelOf(entry.id)}</span>}<span aria-hidden="true">/</span>
          <a href={courseHref}>{courseId || courseName}</a>
          {lecture !== undefined && <><span aria-hidden="true">/</span><span aria-current="page">lec{String(lecture).padStart(2, '0')}</span></>}
        </nav>

        <h1>{lecture !== undefined && <span class="title-kicker">Lec {lecture}</span>}{title}</h1>
        <div class="meta-row">
          <span class="meta-pill">{kind}</span><span aria-hidden="true">·</span><span>{status}</span>
          {lastUpdated && <><span aria-hidden="true">·</span><span>更新于 {lastUpdated}</span></>}
        </div>
      </header>

      <section class="lecture-summary" aria-labelledby="summary-heading"><h2 id="summary-heading">摘要</h2><p>{summary}</p></section>

      {contentEntries.length > 1 && (
        <section class="sequence-grid" aria-label="同课程前后关系">
          <div class="sequence-item"><span>承接</span>{prev ? <a href={idToHref(prev.id)}>{lectureOf(prev) !== undefined ? `Lec ${lectureOf(prev)} · ` : ''}{titleOf(prev)}</a> : <p>这是当前课程已收录的第一篇。</p>}</div>
          <div class="sequence-item"><span>后续</span>{next ? <a href={idToHref(next.id)}>{lectureOf(next) !== undefined ? `Lec ${lectureOf(next)} · ` : ''}{titleOf(next)}</a> : <p>当前课程暂无后续已收录内容。</p>}</div>
        </section>
      )}

      {hasLearningPath && learningPaths ? (
        <div class="note-article">
          <Fragment set:html={learningPathSegments[0]} />
          <LearningPath client:idle data={learningPaths} />
          <Fragment set:html={learningPathSegments.slice(1).join('')} />
        </div>
      ) : <div class="note-article" set:html={contentHtml}></div>}

      {contentEntries.length > 1 && (
        <nav class="prev-next" aria-label="上一篇和下一篇">
          {prev ? <a href={idToHref(prev.id)}><small>← 上一篇{lectureOf(prev) !== undefined ? ` · LEC ${String(lectureOf(prev)).padStart(2, '0')}` : ''}</small><span>{titleOf(prev)}</span></a> : <span></span>}
          {next ? <a href={idToHref(next.id)} class="next"><small>下一篇{lectureOf(next) !== undefined ? ` · LEC ${String(lectureOf(next)).padStart(2, '0')}` : ''} →</small><span>{titleOf(next)}</span></a> : <span></span>}
        </nav>
      )}
    </article>
  </LectureLayout>
) : null}
