---
import type { NavDomain, NavLecture } from '@/lib/notes';

interface Props {
  domains: NavDomain[];
  lectures: NavLecture[];
  courseName: string;
  courseId: string;
  totalNotes: number;
}

const { domains, lectures, courseName, courseId, totalNotes } = Astro.props;
---
<div class="course-nav">
  <section class="nav-section">
    <div class="nav-label">LIBRARY</div>
    <div class="nav-summary"><span>中文笔记</span><span>{totalNotes}</span></div>
    <div class="nav-summary"><span>当前课程</span><span>{lectures.length} 讲</span></div>
  </section>

  <section class="nav-section">
    <div class="nav-label">DOMAINS</div>
    <div class="domain-list">
      {domains.map((domain) => (
        <div class:list={['domain-row', { active: domain.active }]} title={`${domain.courseCount} 门课程 · ${domain.noteCount} 篇讲义`}>
          <span class="domain-caret" aria-hidden="true">{domain.active ? '▾' : '▸'}</span>
          <span>{domain.label}</span>
          <span class="domain-count">{domain.courseCount}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="nav-section current-course">
    <a class="course-heading" href={`/zh/${Astro.url.pathname.split('/')[2]}/`}>
      <span class="course-id">{courseId}</span>
      <span>{courseName.replace(courseId, '').trim()}</span>
    </a>
    <nav aria-label="当前课程讲义" class="lecture-list">
      {lectures.map((lecture) => (
        <a href={lecture.href} aria-current={lecture.current ? 'page' : undefined} class:list={['lecture-link', { current: lecture.current }]}>
          <span class="lecture-no">{String(lecture.number ?? '').padStart(2, '0')}</span>
          <span>{lecture.title}</span>
        </a>
      ))}
    </nav>
  </section>
</div>
