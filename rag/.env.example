# 复制成 .env 后填写。hk 上则写进 /home/mac/mit-cs-notes-rag/.env
#
# 嵌入/重排 和 生成 是两套独立配置，可以分别挑服务商。
# 只有硅基流动和 Voyage 同时提供 embeddings + rerank 两个接口；
# 生成那一侧几乎所有服务商都是 OpenAI 兼容，改三个变量就能换。

# ———— 必填 ————
DATABASE_URL=postgresql://notes:CHANGE_ME@localhost:5432/notes

# 给 IP 加盐哈希用，随便一串随机字符，别用默认值
IP_SALT=change-me-to-something-random

# ———— 嵌入与重排 ————
# 智谱：一个 key 同时覆盖嵌入、重排、生成三件事，Flash 系列免费。
EMBED_PROVIDER=openai-compatible
EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBED_MODEL=embedding-3
RERANK_MODEL=rerank
EMBED_API_KEY=xxxxxxxx.xxxxxxxx
# 必须与模型实际输出维度一致。填错不会静默出错 ——
# ingest 会在写第一批之前校验实际返回长度并报错。
EMBED_DIM=1024
# embedding-3 默认输出 2048 维，而 pgvector 的 HNSW 索引上限是 2000 维
# （实测报错 "column cannot have more than 2000 dimensions for hnsw index"），
# 必须显式压到 1024。
EMBED_EXTRA_BODY={"dimensions":1024}

# ———— 生成 ————
# 智谱 GLM Flash 系列免费；换别家见文件末尾对照表
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7-flash
LLM_API_KEY=xxxxxxxx.xxxxxxxx
LLM_MAX_TOKENS=8000
# glm-4.7-flash 是思考模型。不关掉的话实测会先刷 500+ 个 reasoning 片段、
# 读者干等几十秒才看到第一个字；关掉后首字约 470ms。
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# ———— 可选 ————
RATE_LIMIT_PER_HOUR=20
PORT=3100
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_TOP_K=8
# 「站内有没有写过」的判定阈值，用向量余弦距离（越小越相关）。
# 不用 rerank 分数是因为各家标定差异极大：同一组文档 Voyage 给 0.63/0.26/0.25，
# 智谱给 1.0/0.9994/0.9990 —— 后者拿来做绝对阈值，「没覆盖」分支永远不触发。
RETRIEVAL_MAX_DISTANCE=0.6


# ============================================================
# 换服务商对照表
# ============================================================
#
# ———— 生成（LLM_*）：下面每家都是 OpenAI 兼容，改三个变量即可 ————
#
#   硅基流动（默认，有免费档）
#     LLM_BASE_URL=https://api.siliconflow.cn/v1
#     LLM_MODEL=Qwen/Qwen3-8B
#
#   DeepSeek（非免费但极便宜：一次提问约 $0.001，是 Opus 5 的 1/45）
#     LLM_BASE_URL=https://api.deepseek.com/v1
#     LLM_MODEL=deepseek-v4-flash
#
#   智谱 GLM（Flash 系列免费）
#     LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#     LLM_MODEL=glm-4.7-flash
#
#   Google Gemini（免费档额度可观）
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL=gemini-3.6-flash
#
#   本地 Ollama（完全免费；但 hk 只剩 ~2.9G 内存，跑生成模型不现实）
#     LLM_BASE_URL=http://host.docker.internal:11434/v1
#     LLM_MODEL=qwen3:8b
#     LLM_API_KEY=ollama
#
#   Anthropic 官方（需要境外支付方式）
#     LLM_PROVIDER=anthropic
#     LLM_MODEL=claude-opus-5
#     LLM_EFFORT=medium
#     # 不要设 LLM_BASE_URL
#
#   DeepSeek 的 Anthropic 格式端点（走 anthropic 那条代码路径，但不用官方服务）
#     LLM_PROVIDER=anthropic
#     LLM_BASE_URL=https://api.deepseek.com/anthropic
#     LLM_MODEL=deepseek-v4-flash
#
# ———— 嵌入与重排（EMBED_*）————
#
#   硅基流动（免费档，同样有 rerank 接口，是 Voyage 之外唯一能保住重排那一跳的选择）
#     EMBED_PROVIDER=openai-compatible
#     EMBED_BASE_URL=https://api.siliconflow.cn/v1
#     EMBED_MODEL=BAAI/bge-m3
#     RERANK_MODEL=BAAI/bge-reranker-v2-m3
#     EMBED_DIM=1024
#
#   注意：Gemini、智谱等只有 embeddings 没有 rerank，
#   换过去就得砍掉重排那一跳，检索质量会掉一档。
#
# 换嵌入模型后必须重建库（向量空间不兼容，且 pgvector 的 vector(N) 是定长的）：
#   docker compose exec notes-db psql -U notes -d notes -c 'DROP TABLE IF EXISTS chunks, documents CASCADE'
#   npm run ingest -- --force
