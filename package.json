{
  "name": "archipelago",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run site:dev",
    "build": "npm run site:build",
    "check": "npm run site:check",
    "preview": "npm run site:preview",
    "verify": "npm run site:verify",
    "site:dev": "npm --prefix frontend run dev",
    "site:check": "npm --prefix frontend run check",
    "site:build": "npm --prefix frontend run build",
    "site:build:pages": "DOCS_BASE=/archipelago/ SITE_ORIGIN=https://luomingguo.github.io npm --prefix frontend run build",
    "site:preview": "npm --prefix frontend run preview",
    "site:verify": "npm --prefix frontend run verify:dist && DIST_DIR=$PWD/frontend/dist npm --prefix rag run verify",
    "site:verify:pages": "DOCS_BASE=/archipelago/ npm --prefix frontend run verify:dist",
    "notes:lint": "node tools/notes-lint.mjs",
    "notes:fix": "node tools/notes-fix.mjs",
    "notes:new": "node tools/notes-new.mjs"
  }
}
